# Copy to .env.local and fill in. Never commit real keys.

# ElevenLabs (required for assistant, voices, live call, demo TTS)
ELEVENLABS_API_KEY=
# Alias accepted: ELEVEN_LABS_API_KEY

# Optional TTS model for demo-call audio (default: eleven_flash_v2_5)
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Brave Search (required for automatic manual lookup)
BRAVE_SEARCH_API_KEY=

# Twilio — Account SID must start with AC (not SK, which is an API Key SID).
# REST calls use TWILIO_API_KEY + TWILIO_API_SECRET when both are set;
# otherwise they use TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN.
# ElevenLabs phone import still needs the account Auth Token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Alias accepted: TWILIO_CLIENT_SECRET
TWILIO_PHONE_NUMBER=

# Public origin ElevenLabs/Twilio can reach for /tools/search-manual and /webhooks/sms.
# Leave unset for local-only `just dev`. `just live` injects a Cloudflare quick-tunnel URL
# into the Node process (does not write this file). Set here only for a stable origin
# (named tunnel, Railway, etc.).
# PUBLIC_BASE_URL=https://your-origin.example

# Optional listen port. Unset = OS assigns a free port on 127.0.0.1.
# PORT=

# LLM for scripted demo/monitor dialogue (one provider is enough)
# Prefer OpenRouter, then OpenAI. Override model with LLM_MODEL.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=openai/gpt-5.6-luna

# Optional extras (unused unless you point LLM_MODEL at them)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
